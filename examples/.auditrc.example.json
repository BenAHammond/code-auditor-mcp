{
  "includePaths": [
    "src/**/*.{ts,tsx,js,jsx}",
    "app/**/*.{ts,tsx,js,jsx}",
    "lib/**/*.{ts,tsx,js,jsx}",
    "components/**/*.{ts,tsx,js,jsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/__tests__/**"
  ],

  "analyzerConfigs": {
    "solid": {
      "maxMethodsPerClass": 10,
      "maxLinesPerMethod": 50,
      "maxParametersPerMethod": 4,
      "maxMethodComplexity": 10
    },
    "dry": {
      "minLineThreshold": 5,
      "similarityThreshold": 0.85
    }
  },

  "minSeverity": "high",

  "thresholds": {
    "minHealthScore": 80
  }
}
