{
  "includePaths": [
    "src/**/*.{ts,tsx,js,jsx}",
    "lib/**/*.{ts,tsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}"
  ],

  "analyzerConfigs": {
    "solid": {
      "classMethodsThreshold": 10,
      "maxInterfaceMembers": 15
    },

    "dry": {
      "minLineThreshold": 10,
      "similarityThreshold": 0.90,
      "checkImports": true
    }
  },

  "thresholds": {
    "minHealthScore": 80
  }
}
