{
  "includePaths": [
    "src/**/*.{ts,tsx,js,jsx}",
    "lib/**/*.{ts,tsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}"
  ],

  "analyzerConfigs": {
    "solid": {
      "componentResponsibilityThresholds": {
        "default": 2,
        "layout": 2,
        "dashboard": 3,
        "table": 2
      },

      "classResponsibilityThresholds": {
        "default": 2,
        "repository": 2,
        "service": 3
      },

      "ifElseChainThreshold": 4,
      "switchCaseThreshold": 6,

      "classMethodThreshold": 10,
      "interfaceMemberThreshold": 15
    },

    "dry": {
      "minLineThreshold": 10,
      "similarityThreshold": 0.90,
      "checkImports": true,
      "unusedImportsConfig": {
        "checkLevel": "function",
        "ignorePatterns": ["React", "^_"]
      }
    }
  },

  "thresholds": {
    "minHealthScore": 80
  }
}
