{
  "includePaths": [
    "app/**/*.{ts,tsx,js,jsx}",
    "pages/**/*.{ts,tsx,js,jsx}",
    "components/**/*.{ts,tsx,js,jsx}",
    "lib/**/*.{ts,tsx,js,jsx}",
    "utils/**/*.{ts,tsx,js,jsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/.next/**",
    "**/out/**",
    "**/public/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/__tests__/**",
    "**/coverage/**"
  ],

  "analyzerConfigs": {
    "react": {
      "maxComponentComplexity": 15
    }
  },

  "thresholds": {
    "minHealthScore": 85
  }
}
