{
  "includePaths": [
    "src/**/*.{ts,tsx,js,jsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/__tests__/**",
    "**/coverage/**",
    "**/*.stories.{ts,tsx,js,jsx}"
  ],

  "analyzerConfigs": {
    "react": {
      "maxComponentComplexity": 12
    },
    "solid": {
      "maxMethodsPerClass": 8,
      "maxLinesPerMethod": 40
    },
    "dry": {
      "minLineThreshold": 4,
      "checkImports": true
    }
  },

  "minSeverity": "severe",

  "thresholds": {
    "minHealthScore": 75
  }
}
