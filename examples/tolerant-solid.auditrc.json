{
  "includePaths": [
    "src/**/*.{ts,tsx,js,jsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}"
  ],

  "analyzerConfigs": {
    "solid": {
      "classMethodsThreshold": 40,
      "maxInterfaceMembers": 50,
      "maxMethodComplexity": 100
    },

    "dry": {
      "minLineThreshold": 15,
      "similarityThreshold": 0.85,
      "checkImports": true
    }
  },

  "minSeverity": "severe",

  "thresholds": {
    "minHealthScore": 70
  }
}
