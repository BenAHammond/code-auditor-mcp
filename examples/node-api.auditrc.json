{
  "includePaths": [
    "src/**/*.{ts,js}",
    "lib/**/*.{ts,js}",
    "api/**/*.{ts,js}",
    "routes/**/*.{ts,js}",
    "controllers/**/*.{ts,js}",
    "services/**/*.{ts,js}",
    "models/**/*.{ts,js}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.test.{ts,js}",
    "**/*.spec.{ts,js}",
    "**/__tests__/**",
    "**/coverage/**"
  ],

  "analyzerConfigs": {
    "solid": {
      "maxMethodsPerClass": 12,
      "maxLinesPerMethod": 60,
      "maxParametersPerMethod": 5
    }
  },

  "minSeverity": "severe",

  "thresholds": {
    "minHealthScore": 90
  }
}
