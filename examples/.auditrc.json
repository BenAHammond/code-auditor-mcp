{
  "includePaths": [
    "src/**/*.{ts,tsx,js,jsx}",
    "app/**/*.{ts,tsx,js,jsx}",
    "lib/**/*.{ts,tsx,js,jsx}",
    "components/**/*.{ts,tsx,js,jsx}"
  ],

  "excludePaths": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/__tests__/**",
    "**/vendor/**",
    "**/*.min.js"
  ],

  "analyzerConfigs": {
    "solid": {
      "maxMethodsPerClass": 10,
      "maxLinesPerMethod": 50,
      "maxParametersPerMethod": 4,
      "maxMethodComplexity": 10
    },

    "dry": {
      "minLineThreshold": 5,
      "similarityThreshold": 0.85,
      "checkImports": true,
      "checkStrings": true
    },

    "react": {
      "maxComponentComplexity": 15
    },

    "data-access": {
      "performanceThresholds": {
        "maxJoins": 5,
        "warnOnSelectStar": true
      }
    }
  },

  "minSeverity": "high",

  "thresholds": {
    "minHealthScore": 80
  }
}
